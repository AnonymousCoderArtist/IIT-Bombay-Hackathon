# MongoDB - Atlas ka connection string use karo (production)
MONGODB_URI=mongodb://localhost:27017/smart-campus

# NextAuth ke liye secret - `openssl rand -base64 32` se banao
AUTH_SECRET=

# Local/self-hosted pe run karne par trust host enable karo (Vercel pe needed nahi)
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP ke liye SMTP (Gmail App Password ya Resend/Mailtrap use karo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Campus <noreply@smartcampus.edu>
