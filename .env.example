# MongoDB - Atlas ka connection string use karo (production)
MONGODB_URI=mongodb://localhost:27017/smart-campus

# NextAuth ke liye secret - `openssl rand -base64 32` se banao
AUTH_SECRET=

# Local/self-hosted pe run karne par trust host enable karo (Vercel pe needed nahi)
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (bonus features) - "mock" default, kabhi API key nahi to app toot-ta nahi
# Python AI service (RAG + LLM) - services/ai/ me uvicorn chalao
# AI_SERVICE_URL=http://localhost:8000
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# OpenAI-compatible provider (default for all users; users apna key Settings > AI me bhi laga sakte hain)
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini

# Face liveness (anti-spoofing) bypass - sirf testing ke liye (static photo se test karne pe)
# FACE_LIVENESS_DISABLED=1
# Face service start: cd services/ai && uv run uvicorn app.main:app --port 8000

# Email OTP ke liye SMTP (Gmail App Password ya Resend/Mailtrap use karo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Campus <noreply@smartcampus.edu>

# Emails me links ke liye (production me apna domain daalo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (browser notifications) - VAPID keys generate karo:
# npx web-push generate-vapid-keys --json
# Phir values yahan daalo (PUBLIC wali ko NEXT_PUBLIC me bhi copy karo)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@smartcampus.edu
