# Smart Campus AI service env
# Free LLM choose karo: gemini (Google AI Studio) ya deepseek (DeepSeek platform)
# Key nahi daali toh service mock mode me chalti hai (RAG retrieval still works)
AI_PROVIDER=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Face models — by default repo me bundled hain (services/ai/models/, ko download nahi hota)
# Agar alag jagah rakhna ho toh path daalo, warna khali chhodo
# UNIFACE_CACHE_DIR=

# Liveness threshold (0-1) — printed/screen photo reject ke liye
# LIVENESS_THRESHOLD=0.6
# Static photo se test karna ho toh 1 set karo:
# FACE_LIVENESS_DISABLED=1
